# fake is deterministic and suitable for UI/API development.
AGENT_RUNTIME=fake
# Use the local Pi CLI for real agent turns.
# AGENT_RUNTIME=pi
# PI_CWD=D:\Documents\ProjectsPet\chat-pi
# PI_BIN=pi.cmd
# PI_PROVIDER=
# PI_MODEL=
# PI_AGENT_DIR=D:\PiAgents\runtime
# Stable node identity. If omitted, it is stored as PI_AGENT_DIR/server-id when
# PI_AGENT_DIR is configured; set an explicit UUID for a cloned/deployed node.
# PI_SERVER_ID=00000000-0000-4000-8000-000000000000
# PI_SERVER_ID_FILE=D:\PiAgents\runtime\server-id
# Optional bearer auth for all API/SSE endpoints except health/capabilities.
# Prefer a secret file in production; never commit either value.
# PI_AUTH_TOKEN=replace-with-a-long-random-token
# PI_AUTH_TOKEN_FILE=/run/secrets/pi-auth-token

PORT=8787
# Standalone API only listens on loopback by default. Set to a specific
# Tailscale IP when a trusted tailnet device must reach it.
# API_HOST=100.116.45.50
# On Windows, PI_SANDBOX_MODE=none is allowed for a Pi runtime only when this
# explicit flag is true. Prefer running the API/Pi inside WSL2 or a container.
# PI_TRUSTED_MODE=false
MAX_BODY_BYTES=1048576
# Enable only behind a trusted reverse proxy that overwrites X-Forwarded-For.
TRUST_PROXY=false
# Emits a structured warning when free space near DB_PATH falls below this value.
DISK_WARNING_FREE_BYTES=1073741824
DISK_CHECK_INTERVAL_SECONDS=300
# Required for NODE_ENV=production. Comma-separated origins; no paths.
# CORS_ORIGINS=https://chat.example.ts.net,http://100.116.45.50:8092
